# Cloudflare Pages installs with `npm ci` before running the build command.
# If `NODE_ENV=production` is ever set in the Pages dashboard, npm treats the
# devDependencies as omittable — and that is where Vite lives, so the build dies
# with "vite: not found" before it starts. Pinning `include=dev` here makes the
# install independent of that variable, so the deploy works either way.
#
# Verified with `NODE_ENV=production npm ci`: without this file `node_modules/vite`
# is absent, with it the build runs.
include=dev
