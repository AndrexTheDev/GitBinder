      "viewports": ["desktop", "tablet", "mobile"],
      "fixture": "ok",
      "seed": { "username": "octodemo" },
      "expect": {
        "count": { ".repo-card": 12 },
        "selectors": [".repo-card[data-slug=\"octodemo/gitbinder\"]"]
      }
    },
    {
      "id": "m03-fetch-paged",
      "module": "M03",
      "title": "103 repositories across two pages",
      "why": "Page 1 must be full before the Link header is followed; nothing may be dropped.",
      "viewport": "desktop",
      "fixture": "paged",
      "seed": { "username": "octodemo" },
      "expect": { "count": { ".repo-card": 103 } }
    },
    {
      "id": "m03-fetch-empty",
      "module": "M03",
      "title": "Account with no repositories",
      "why": "Empty is not an error — the copy has to say so without alarming anyone.",
      "viewport": "desktop",
      "fixture": "empty",
      "seed": { "username": "octodemo" },
      "expect": { "count": { ".repo-card": 0 }, "selectors": ["#library-root"] }
    },
    {
      "id": "m03-error-notfound",
      "module": "M03",
      "title": "Unknown username (404)",
      "why": "The most common real failure: a typo in the username.",
      "viewport": "desktop",
      "viewports": ["desktop", "mobile"],
      "fixture": "notFound",
      "seed": { "username": "no-such-user" },
      "expect": { "selectors": ["#library-root"], "count": { ".repo-card": 0 } }
    },
    {
      "id": "m03-error-ratelimit",
      "module": "M03",
      "title": "Anonymous rate limit hit (403)",
      "why": "Must name the reset time — otherwise the visitor just retries into the same wall.",
      "viewport": "desktop",
      "fixture": "rateLimit",
      "seed": { "username": "octodemo" },
      "expect": { "count": { ".repo-card": 0 } }
    },
    {
      "id": "m03-error-unauthorized",
      "module": "M03",
      "title": "Bad credentials (401)",
      "why": "A stored token that was revoked must not look like a network failure.",
      "viewport": "desktop",
      "fixture": "unauthorized",
      "seed": { "username": "octodemo", "token": "ghp_betafixturetoken0000000000000000" },
      "expect": { "count": { ".repo-card": 0 } }
    },
    {
      "id": "m03-error-offline",
      "module": "M03",
      "title": "No network at all",
      "why": "fetch() rejects — the app has to offer a retry, not hang on skeletons.",
      "viewport": "desktop",
      "fixture": "offline",
      "seed": { "username": "octodemo" },
      "expect": { "count": { ".repo-card": 0 } }
    },
    {
      "id": "m03-error-server",
      "module": "M03",
      "title": "GitHub 502",
      "why": "Server-side failure maps to its own message and tone.",
      "viewport": "desktop",
      "fixture": "server",
      "seed": { "username": "octodemo" },
      "expect": { "count": { ".repo-card": 0 } }
    },
    {
      "id": "m03-fetch-private",
      "module": "M03",
      "title": "Token present: private work appears",
      "why": "/user/repos instead of /users/{login}/repos, and the private repo is included.",
      "viewport": "desktop",
      "fixture": "token",
      "seed": { "username": "octodemo", "token": "ghp_betafixturetoken0000000000000000" },
      "expect": {
        "count": { ".repo-card": 13 },
        "selectors": [".repo-card[data-slug=\"octodemo/private-vault\"]"]
      }
    },

    {
      "id": "m04-search",
      "module": "M04",
      "title": "Search filters the list",
