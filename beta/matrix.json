{
  "$comment": [
    "GitBinder beta run — the screenshot matrix.",
    "",
    "One entry per *scenario*, expanded by the runner over `viewports` x `langs`.",
    "Every selector below is a hook that exists in src/ today (verified by reading",
    "the component that renders it): .repo-card[data-slug], .book-picker__toggle,",
    ".tabs__tab, #settings-token, [data-i18n=\"...\"] .",
    "",
    "`expect` turns a picture into an assertion: the runner fails the shot when a",
    "selector is missing, a count is wrong, or the page overflows horizontally.",
    "`beta/runner/selfcheck.mjs` cross-checks that every `fixture` named here exists."
  ],

  "viewports": {
    "desktop": { "width": 1440, "height": 900 },
    "tablet": { "width": 820, "height": 1180 },
    "mobile": { "width": 390, "height": 844 },
    "small": { "width": 320, "height": 568 },
    "wide": { "width": 1920, "height": 1080 }
  },

  "locales": {
    "en": "en-US",
    "de": "de-DE"
  },

  "modules": [
    { "id": "M00", "name": "Baseline & build", "shots": [] },
    { "id": "M01", "name": "Layout shell" },
    { "id": "M02", "name": "i18n (EN/DE)" },
    { "id": "M03", "name": "GitHub integration" },
    { "id": "M04", "name": "Repository manager" },
    { "id": "M05", "name": "Repository card & overrides" },
    { "id": "M06", "name": "Status auto-detection" },
    { "id": "M07", "name": "Settings drawer" },
    { "id": "M08", "name": "Summary & chapter picker" },
    { "id": "M09", "name": "Book studio & preview" },
    { "id": "M10", "name": "Print / PDF" },
    { "id": "M11", "name": "Text exports" },
    { "id": "M12", "name": "Support & donations" },
    { "id": "M13", "name": "Legal & info modals" },
    { "id": "M14", "name": "Ad-blocker gate" },
    { "id": "M15", "name": "A11y & responsive" },
    { "id": "M16", "name": "Persistence & migration" }
  ],

  "shots": [
    {
      "id": "m01-shell-empty",
      "module": "M01",
      "title": "First visit, nothing fetched yet",
      "why": "The state every new visitor lands in: hero, empty library, empty summary.",
      "viewport": "desktop",
      "viewports": ["desktop", "tablet", "mobile"],
      "langs": ["en"],
      "expect": {
        "selectors": ["#hero-root", "#library-root", "#summary-root", "#navbar-root", "#footer-root"],
        "text": [{ "sel": "#library-root", "contains": "octodemo", "not": true }]
      }
    },
    {
      "id": "m01-shell-empty-de",
      "module": "M01",
      "title": "First visit — German",
      "why": "The same empty state with the DE dictionary applied.",
      "viewport": "desktop",
      "viewports": ["desktop", "mobile"],
      "langs": ["de"],
      "seed": { "lang": "de" },
      "expect": { "selectors": ["#hero-root"], "htmlLang": "de" }
    },
    {
      "id": "m01-shell-scrolled",
      "module": "M01",
      "title": "Sticky navbar after scrolling",
      "why": "The navbar is position:sticky — it has to stay legible over content.",
      "viewport": "desktop",
      "fixture": "ok",
      "seed": { "username": "octodemo" },
      "steps": [{ "scroll": { "y": 700 } }, { "wait": 400 }],
      "expect": { "selectors": [".repo-card"] }
    },

    {
      "id": "m02-i18n-loaded-de",
      "module": "M02",
      "title": "Loaded library in German",
      "why": "Longest German labels in the real layout — the classic overflow case.",
      "viewport": "desktop",
      "viewports": ["desktop", "mobile"],
      "langs": ["de"],
      "fixture": "ok",
      "seed": { "username": "octodemo", "lang": "de" },
      "expect": { "count": { ".repo-card": 12 }, "htmlLang": "de" }
    },
    {
      "id": "m02-i18n-toggle",
      "module": "M02",
      "title": "Language toggle mid-session",
      "why": "Switching locale must re-label everything already rendered, not just new nodes.",
      "viewport": "desktop",
      "fixture": "ok",
      "seed": { "username": "octodemo" },
      "steps": [
        { "click": { "sel": ".segmented__option", "nth": 1 } },
        { "wait": 500 }
      ],
      "expect": { "count": { ".repo-card": 12 }, "htmlLang": "de" }
    },

    {
      "id": "m03-fetch-loading",
      "module": "M03",
      "title": "Fetch in flight (skeletons)",
      "why": "2.5 s fixture delay: the loading skeleton is what visitors actually see.",
      "viewport": "desktop",
      "fixture": "slow",
      "seed": { "username": "octodemo" },
      "capture": "immediate",
      "expect": { "selectors": ["#library-root"] }
    },
    {
      "id": "m03-fetch-loaded",
      "module": "M03",
      "title": "Twelve repositories fetched",
