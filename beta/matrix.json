      "viewport": "desktop",
      "viewports": ["desktop", "mobile"],
      "fixture": "ok",
      "seed": { "username": "octodemo" },
      "steps": [
        { "fill": { "sel": "#library-root input[type=\"search\"]" }, "value": "pdf" },
